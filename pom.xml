 	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/hansenjn/CiliaQ/issues</url>
	</issueManagement>
 	
 	<ciManagement>
		<system>None</system>
	</ciManagement>
 	
 	<properties>
		<main-class>CiliaQMain</main-class>
		<package-name>ciliaQ_jnh</package-name>
		<license.licenseName>gpl_v3</license.licenseName>
		<license.copyrightOwners>Jan Niklas Hansen.</license.copyrightOwners>
		<license.projectName>CiliaQ plugin for ImageJ.</license.projectName>
	</properties>
 	
 	<!--	New in v0.2.2: net.imagej:ij is hosted on the SciJava repository,
 			which newer pom-scijava versions no longer declare	-->
 	<repositories>
    	<repository>
        	<id>scijava.public</id>
        	<url>https://maven.scijava.org/content/groups/public</url>
    	</repository>
    </repositories>
 	
    <dependencies>
        <!-- ImageJ dependencies -->
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>ij</artifactId>
        </dependency>
    </dependencies>  
    
    <build>
		<plugins>
			<!--         avoid errors in java doc creation -->			
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<configuration>
					<doclint>none</doclint>
				</configuration>
			</plugin>
			
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<mainClass>${main-class}</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			
			<!-- New in v0.2.2 (as in CiliaQ Preparator): turn off the parent's populate-app, which copies the WHOLE dependency
				 tree into Fiji and upgrades shared libraries such as slf4j. Since only the CiliaQ jar is copied (below), Fiji is
				 tested as users install it from the update site. -->
			<plugin>
				<groupId>org.scijava</groupId>
				<artifactId>scijava-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>populate-app</id>
						<phase>none</phase>
					</execution>
				</executions>
			</plugin>
			
			<!-- New in v0.2.2: copy the CiliaQ jar into the local Fiji (scijava.app.directory) on every build -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-jar-to-fiji</id>
						<phase>package</phase>
						<goals><goal>run</goal></goals>
						<configuration>
							<target>
								<!-- delete first: Windows allows deleting a loaded jar (the handle stays open), then a fresh file is
									 written, which avoids the overwrite-in-use lock. This also removes a CiliaQ jar installed from the
									 update site, since two CiliaQ jars in plugins would conflict. -->
								<delete>
									<fileset dir="${scijava.app.directory}/plugins"
											 includes="${project.artifactId}-*.jar"/>
								</delete>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}.jar"
									  todir="${scijava.app.directory}/plugins"/>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>  
</project>