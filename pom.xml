		</mailingList>
	</mailingLists>
 	
 	<scm>
		<connection>scm:git:git://github.com/hansenjn/CiliaQ</connection>
		<developerConnection>scm:git:git@github.com:hansenjn/CiliaQ</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/hansenjn/CiliaQ</url>
